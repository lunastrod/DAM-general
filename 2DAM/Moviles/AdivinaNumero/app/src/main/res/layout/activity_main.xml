<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="358dp"
        android:layout_height="591dp"
        android:background="#EDBBFA"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtIntentos"
            android:layout_width="match_parent"
            android:layout_height="67dp"
            android:text="Intentos restantes: error"
            android:textSize="24dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPista"
            android:layout_width="match_parent"
            android:layout_height="364dp"
            android:gravity="center"
            android:text="Debes adivinar el número secreto entre 1 y 100.\nTienes 5 intentos"
            android:textSize="24dp" />

        <EditText
            android:id="@+id/editNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:gravity="center"
            android:inputType="number" />

        <Button
            android:id="@+id/btnComparacion"
            android:layout_width="match_parent"
            android:layout_height="73dp"
            android:text="Prueba este número"
            android:textSize="24dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>